# ============================================================
# .editorconfig — Consistent formatting across editors
# https://editorconfig.org
# ============================================================

root = true

[*]
charset              = utf-8
end_of_line          = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{tf,tfvars}]
indent_style         = terraform
indent_size         = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
